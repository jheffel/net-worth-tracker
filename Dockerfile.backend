# Stage 1: Build the React frontend
FROM node:18-alpine AS frontend-build

WORKDIR /app/client

COPY client/package*.json ./
RUN npm install

COPY client/ ./
RUN npm run build

# Stage 2: Backend
FROM node:18-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY server/ ./server/
COPY config/ ./config/

COPY --from=frontend-build /app/client/build ./client/build

EXPOSE 5000

CMD ["npm", "start"]
